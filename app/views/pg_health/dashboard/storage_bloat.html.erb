<main class="layout__content">
  <div class="content-wrapper">
    <!-- Page Header -->
    <div class="page-header">
      <div>
        <h1 class="page-header__title">Storage & Bloat Analysis</h1>
        <p class="page-header__description">Table and index bloat detection with growth trends.</p>
      </div>
      <div class="page-header__actions">
        <button class="btn btn--secondary">
          <span class="material-symbols-outlined btn-icon">refresh</span>
          Recalculate Bloat
        </button>
      </div>
    </div>

    <!-- Key Metrics -->
    <div class="grid grid--4-col">
      <div class="metric-card">
        <span class="metric-card__label">Total DB Size</span>
        <span class="metric-card__value">847 GB</span>
        <span class="metric-card__change">↑ 4.2% growth/week</span>
      </div>
      <div class="metric-card">
        <span class="metric-card__label">Estimated Wasted</span>
        <span class="metric-card__value metric-card__value--warning">142 GB</span>
        <span class="metric-card__change">16.8% of total size</span>
      </div>
      <div class="metric-card">
        <span class="metric-card__label">Table Bloat Avg</span>
        <span class="metric-card__value metric-card__value--warning">12.1%</span>
        <span class="metric-card__change">Within threshold</span>
      </div>
      <div class="metric-card">
        <span class="metric-card__label">Index Bloat Avg</span>
        <span class="metric-card__value metric-card__value--warning">18.7%</span>
        <span class="metric-card__change">↑ 2.3% from last week</span>
      </div>
    </div>

    <!-- Storage Breakdown & Table Bloat -->
    <div class="grid grid--2-col">
      <div class="card">
        <div class="card-header">
          <span class="card-header__title">Storage Breakdown by Database</span>
        </div>
        <div class="card-content">
          <div style="display: flex; flex-direction: column; gap: 16px;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font: 400 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface-variant);">production</span>
                <span style="font: 600 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface);">542 GB</span>
              </div>
              <div class="progress">
                <div class="progress__bar" style="width: 64%;"></div>
              </div>
            </div>
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font: 400 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface-variant);">staging</span>
                <span style="font: 600 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface);">198 GB</span>
              </div>
              <div class="progress">
                <div class="progress__bar" style="width: 23%;"></div>
              </div>
            </div>
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font: 400 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface-variant);">development</span>
                <span style="font: 600 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface);">107 GB</span>
              </div>
              <div class="progress">
                <div class="progress__bar" style="width: 13%;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span class="card-header__title">Largest Tables by Size</span>
        </div>
        <div class="card-content">
          <div style="display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div style="flex: 1; min-width: 0;">
                <div style="font: 500 12px / 16px 'JetBrains Mono', monospace; color: var(--color-on-surface); margin-bottom: 4px; word-break: break-all;">event_logs</div>
                <div style="font: 400 12px / 16px 'Inter', sans-serif; color: var(--color-on-surface-variant);">Bloat: 24.3%</div>
              </div>
              <span style="font: 600 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface); white-space: nowrap; margin-left: 8px;">412 GB</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div style="flex: 1; min-width: 0;">
                <div style="font: 500 12px / 16px 'JetBrains Mono', monospace; color: var(--color-on-surface); margin-bottom: 4px; word-break: break-all;">audit_trail</div>
                <div style="font: 400 12px / 16px 'Inter', sans-serif; color: var(--color-on-surface-variant);">Bloat: 8.2%</div>
              </div>
              <span style="font: 600 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface); white-space: nowrap; margin-left: 8px;">198 GB</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div style="flex: 1; min-width: 0;">
                <div style="font: 500 12px / 16px 'JetBrains Mono', monospace; color: var(--color-on-surface); margin-bottom: 4px; word-break: break-all;">transaction_history</div>
                <div style="font: 400 12px / 16px 'Inter', sans-serif; color: var(--color-on-surface-variant);">Bloat: 15.7%</div>
              </div>
              <span style="font: 600 13px / 18px 'Inter', sans-serif; color: var(--color-on-surface); white-space: nowrap; margin-left: 8px;">148 GB</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bloat Analysis Table - Desktop -->
    <div class="card hidden-desktop" style="display: none;">
      <div class="card-header">
        <span class="card-header__title">Table Bloat Analysis (top 10)</span>
        <div class="card-header__actions">
          <button class="icon-button" style="width: 32px; height: 32px;">
            <span class="material-symbols-outlined">filter_list</span>
          </button>
        </div>
      </div>
      <div class="card-content">
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Table Name</th>
                <th>Live Bytes</th>
                <th>Dead Bytes</th>
                <th>Bloat %</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="table__cell-code">event_logs</td>
                <td class="table__cell-number">310 GB</td>
                <td class="table__cell-number">102 GB</td>
                <td class="table__cell-number text-error">24.3%</td>
                <td><span class="badge badge--critical"><span class="badge__dot"></span> VACUUM FULL</span></td>
              </tr>
              <tr>
                <td class="table__cell-code">transaction_history</td>
                <td class="table__cell-number">125 GB</td>
                <td class="table__cell-number">23 GB</td>
                <td class="table__cell-number text-warning">15.7%</td>
                <td><span class="badge badge--warning"><span class="badge__dot"></span> ANALYZE</span></td>
              </tr>
              <tr>
                <td class="table__cell-code">user_activity</td>
                <td class="table__cell-number">87 GB</td>
                <td class="table__cell-number">9.4 GB</td>
                <td class="table__cell-number text-warning">9.8%</td>
                <td><span class="badge badge--warning"><span class="badge__dot"></span> MONITOR</span></td>
              </tr>
              <tr>
                <td class="table__cell-code">api_requests</td>
                <td class="table__cell-number">64 GB</td>
                <td class="table__cell-number">6.2 GB</td>
                <td class="table__cell-number text-warning">8.8%</td>
                <td><span class="badge badge--warning"><span class="badge__dot"></span> MONITOR</span></td>
              </tr>
              <tr>
                <td class="table__cell-code">audit_trail</td>
                <td class="table__cell-number">182 GB</td>
                <td class="table__cell-number">14.8 GB</td>
                <td class="table__cell-number">7.5%</td>
                <td><span class="badge badge--healthy"><span class="badge__dot"></span> HEALTHY</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Bloat Analysis - Mobile -->
    <div class="card-list hidden-desktop">
      <div class="card-header" style="margin-bottom: 8px;">
        <span class="card-header__title">Table Bloat Analysis (top 5)</span>
      </div>
      
      <div class="card-list-item">
        <div class="card-list-item__header">
          <div>
            <div class="card-list-item__title">event_logs</div>
            <div class="card-list-item__subtitle">Live: 310 GB</div>
          </div>
          <span class="badge badge--critical"><span class="badge__dot"></span> CRITICAL</span>
        </div>
        <div class="card-list-item__body">
          <div class="card-list-item__field">
            <span class="card-list-item__field-label">Dead Bytes</span>
            <span class="card-list-item__field-value">102 GB</span>
          </div>
          <div class="card-list-item__field">
            <span class="card-list-item__field-label">Bloat %</span>
            <span class="card-list-item__field-value text-error">24.3%</span>
          </div>
        </div>
      </div>

      <div class="card-list-item">
        <div class="card-list-item__header">
          <div>
            <div class="card-list-item__title">transaction_history</div>
            <div class="card-list-item__subtitle">Live: 125 GB</div>
          </div>
          <span class="badge badge--warning"><span class="badge__dot"></span> WARNING</span>
        </div>
        <div class="card-list-item__body">
          <div class="card-list-item__field">
            <span class="card-list-item__field-label">Dead Bytes</span>
            <span class="card-list-item__field-value">23 GB</span>
          </div>
          <div class="card-list-item__field">
            <span class="card-list-item__field-label">Bloat %</span>
            <span class="card-list-item__field-value text-warning">15.7%</span>
          </div>
        </div>
      </div>

      <div class="card-list-item">
        <div class="card-list-item__header">
          <div>
            <div class="card-list-item__title">user_activity</div>
            <div class="card-list-item__subtitle">Live: 87 GB</div>
          </div>
          <span class="badge badge--warning"><span class="badge__dot"></span> WARNING</span>
        </div>
        <div class="card-list-item__body">
          <div class="card-list-item__field">
            <span class="card-list-item__field-label">Dead Bytes</span>
            <span class="card-list-item__field-value">9.4 GB</span>
          </div>
          <div class="card-list-item__field">
            <span class="card-list-item__field-label">Bloat %</span>
            <span class="card-list-item__field-value text-warning">9.8%</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>